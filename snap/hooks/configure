#!/bin/sh
set -eu

address="$(snapctl get address)"
if [ -z "$address" ]; then
  address=127.0.0.1:3000
  snapctl set address="$address"
fi
case "$address" in
  *[![:print:]]*)
    echo 'address must not contain control characters' >&2
    exit 1
    ;;
esac
if ! printf '%s\n' "$address" | grep -Eq '^([A-Za-z0-9][A-Za-z0-9.-]*|\[[0-9A-Fa-f:.]+\]):[0-9]{1,5}$'; then
  echo 'address must be host:port or [IPv6]:port' >&2
  exit 1
fi
port="${address##*:}"
if [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
  echo 'address port must be between 1024 and 65535' >&2
  exit 1
fi

if snapctl services "$SNAP_INSTANCE_NAME.drawdb" | awk 'NR > 1 {print $3}' | grep -qx active; then
  snapctl restart "$SNAP_INSTANCE_NAME.drawdb"
fi
