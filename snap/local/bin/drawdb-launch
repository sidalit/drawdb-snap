#!/bin/sh
set -eu

umask 022
address="$(snapctl get address)"
cat > "$SNAP_DATA/nginx.conf" <<EOF
worker_processes 1;
pid $SNAP_COMMON/nginx/nginx.pid;
error_log stderr warn;

events {
    worker_connections 512;
}

http {
    include $SNAP/etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_body_temp_path $SNAP_COMMON/nginx/client_body;
    proxy_temp_path $SNAP_COMMON/nginx/proxy;
    fastcgi_temp_path $SNAP_COMMON/nginx/fastcgi;
    uwsgi_temp_path $SNAP_COMMON/nginx/uwsgi;
    scgi_temp_path $SNAP_COMMON/nginx/scgi;

    server {
        listen $address;
        server_name _;
        root $SNAP/share/drawdb;
        index index.html;

        location / {
            try_files \$uri /index.html;
        }
    }
}
EOF

exec "$SNAP/usr/bin/setpriv" \
  --clear-groups --reuid _daemon_ --regid _daemon_ -- \
  "$SNAP/usr/sbin/nginx" \
  -p "$SNAP_COMMON/nginx/" -c "$SNAP_DATA/nginx.conf" \
  -e stderr -g 'daemon off;'
